{
  "name": "bo-cong-cu",
  "version": "1.2.0",
  "private": true,
  "description": "Bộ công cụ hỗ trợ test dạng Chrome extension. Công cụ đầu tiên: Kiểm tra Redirect, có thêm bản web và bản dòng lệnh chạy bằng Node.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "redirect",
    "affiliate",
    "testing",
    "qa"
  ],
  "author": "viet.vd",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ui": "node node/server.js",
    "start": "node node/trace.js",
    "detail": "node node/trace.js --repeat 1 --detail",
    "setup": "npm install && npx playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "node scripts/check.js",
    "verify": "npm run lint && npm run check",
    "ext:zip": "node scripts/zip-extension.js",
    "version": "node scripts/sync-version.js && git add extension/manifest.json"
  },
  "dependencies": {
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
