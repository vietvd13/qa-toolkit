{
  "name": "qa-toolkit",
  "displayName": "Bộ công cụ",
  "version": "1.2.0",
  "private": true,
  "description": "A modular Chrome extension (Manifest V3) that brings everyday QA and testing utilities together in one hub, with a shared design system, light/dark themes and an optional local web version.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "qa",
    "testing",
    "toolkit",
    "productivity",
    "developer-tools"
  ],
  "author": {
    "name": "vietvd13",
    "url": "https://github.com/vietvd13"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ui": "node node/server.js",
    "start": "node node/trace.js",
    "detail": "node node/trace.js --repeat 1 --detail",
    "setup": "npm install && npx playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "node scripts/check.js",
    "verify": "npm run lint && npm run check",
    "ext:zip": "node scripts/zip-extension.js",
    "version": "node scripts/sync-version.js && git add extension/manifest.json",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7"
  }
}
