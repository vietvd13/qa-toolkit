{
  "manifest_version": 3,
  "name": "Bộ công cụ",
  "version": "1.2.0",
  "description": "Bộ công cụ hỗ trợ test. Hiện có: Kiểm tra Redirect (ghi lại từng bước chuyển hướng và vị trí các tham số affiliate).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bộ công cụ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "tabs",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
